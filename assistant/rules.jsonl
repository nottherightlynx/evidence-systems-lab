{"doc_id": "lifecycle-01", "version": "1.0", "owner": "Demo Analyst", "domain": "supporter", "effective_from": "2026-01-01", "source_url": "synthetic://standards/lifecycle-01", "access_class": "public", "content_hash": "f20e985486e13911ba90cfd28085429773e1fc7b37b5773bf0b8d1cdc8581446", "text": "Entry means earliest observed event within the available data, not necessarily first-ever contact."}
{"doc_id": "lifecycle-02", "version": "1.0", "owner": "Demo Analyst", "domain": "supporter", "effective_from": "2026-01-01", "source_url": "synthetic://standards/lifecycle-02", "access_class": "public", "content_hash": "bdac9f2d29f2860bf8a784ffcf04a041687d0924a381c0d5933bd22f45940345", "text": "Verified engagement requires an approved registration or attendance source event linked to a verified canonical identity. Unresolved events remain visible separately."}
{"doc_id": "lifecycle-03", "version": "1.0", "owner": "Demo Analyst", "domain": "supporter", "effective_from": "2026-01-01", "source_url": "synthetic://standards/lifecycle-03", "access_class": "public", "content_hash": "259c9e39764a36f273e71bc7f85099f85b3a18c0edfc4020c42d0ddd565f9fb2", "text": "Received cash requires status received on a distinct payment event. A pledge is not received cash; refunds are separate transactions."}
{"doc_id": "lifecycle-04", "version": "1.0", "owner": "Demo Analyst", "domain": "supporter", "effective_from": "2026-01-01", "source_url": "synthetic://standards/lifecycle-04", "access_class": "public", "content_hash": "ea62beccf8e43a92cabf12ff08a4c3c39c15c974da6fdddfaf65506ac7e5a012", "text": "Time ordering supports a descriptive lifecycle but does not prove an interaction caused a contribution. Historical completeness must be documented."}
{"doc_id": "source-01", "version": "1.0", "owner": "Demo Analyst", "domain": "jurisdiction", "effective_from": "2026-01-01", "source_url": "synthetic://standards/source-01", "access_class": "public", "content_hash": "fb8b79922299da63c356d1c710fdd8f294b8a86970ab839b3317c53af646a1ce", "text": "For each record preserve source identifier, original URL, jurisdiction, published_at, retrieved_at, and source classification."}
{"doc_id": "source-02", "version": "1.0", "owner": "Demo Analyst", "domain": "jurisdiction", "effective_from": "2026-01-01", "source_url": "synthetic://standards/source-02", "access_class": "public", "content_hash": "91090de7a8a49a72cf1aa8800afd2c4d2c814c5b0950d3d10fb8a4ffcb0921b1", "text": "Published_at indicates the source publication date; retrieved_at indicates when this pipeline fetched the record. Never interchange them."}
{"doc_id": "source-03", "version": "1.0", "owner": "Demo Analyst", "domain": "jurisdiction", "effective_from": "2026-01-01", "source_url": "synthetic://standards/source-03", "access_class": "public", "content_hash": "7cfa482d7ab8825747c52d6c5d7e4663892c859b7e726205f2598bb1f2ec9166", "text": "Missing source data must be classified separately as not fetched, failed retrieval, stale, empty search results, or incomplete coverage."}
{"doc_id": "source-04", "version": "1.0", "owner": "Demo Analyst", "domain": "jurisdiction", "effective_from": "2026-01-01", "source_url": "synthetic://standards/source-04", "access_class": "public", "content_hash": "97266cb3379e23daffbc660ef370c07aaffd7f63c461514b0cf97b45742ce7de", "text": "SIMULATED state feeds are fixtures, not evidence of actual state legislative activity or geographic coverage."}
{"doc_id": "governance-01", "version": "1.0", "owner": "Demo Analyst", "domain": "governance", "effective_from": "2026-01-01", "source_url": "synthetic://standards/governance-01", "access_class": "public", "content_hash": "45f975304b9ce385e0696f34a6b1043985f563b3880fbab6e88fc5f064f78d91", "text": "Apply authorization before retrieval and query execution; never let model-generated text define access permissions."}
{"doc_id": "governance-02", "version": "1.0", "owner": "Demo Analyst", "domain": "governance", "effective_from": "2026-01-01", "source_url": "synthetic://standards/governance-02", "access_class": "public", "content_hash": "533e178a234434ce9a3e18524e2cea17e0ddefd881fc1d46ea381f9322c5b479", "text": "Use approved metric IDs and parameterized operations. Never execute arbitrary SQL from natural language."}
{"doc_id": "governance-03", "version": "1.0", "owner": "Demo Analyst", "domain": "governance", "effective_from": "2026-01-01", "source_url": "synthetic://standards/governance-03", "access_class": "public", "content_hash": "a0305b18e937bce909477d3f5beff25f6ee82554fbe148b43d6df3c10d17fd5e", "text": "Reject unsupported causal claims, unsupported identity matches, and attempts to substitute an outdated metric definition."}
{"doc_id": "governance-04", "version": "1.0", "owner": "Demo Analyst", "domain": "governance", "effective_from": "2026-01-01", "source_url": "synthetic://standards/governance-04", "access_class": "public", "content_hash": "fac738f998e4ab66b65b5ebea15e4c9aa04350b975e52d5e9250336c2fd23bb9", "text": "Return metric ID, definition version, as-of information, evidence source IDs, missingness, and limitations. Sensitive outputs need human review."}
{"doc_id": "restricted-01", "version": "1.0", "owner": "Demo Analyst", "domain": "governance", "effective_from": "2026-01-01", "source_url": "synthetic://standards/restricted-01", "access_class": "restricted", "content_hash": "feb1363b3b04608cdcb96271029b692e4e13349318e83795556451d238c843d5", "text": "Fictional restricted reviewer memo. This must never be retrieved by the public role."}
